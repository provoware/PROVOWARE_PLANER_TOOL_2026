{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PROVOWARE Planer 2026",
  "version": "0.4.0-dev.1",
  "identifier": "de.provoware.planer2026",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PROVOWARE Planer 2026",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-src 'none'; connect-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
