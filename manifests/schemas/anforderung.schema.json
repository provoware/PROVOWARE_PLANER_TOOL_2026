{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provoware.local/schemas/anforderung.schema.json",
  "title": "PROVOWARE Anforderung",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "titel", "beschreibung", "prioritaet", "status", "todo_id", "akzeptanzkriterien", "test_ids", "evidenz_ids"],
  "properties": {
    "id": {"type": "string", "pattern": "^REQ-[A-Z0-9][A-Z0-9._-]*$"},
    "titel": {"type": "string", "minLength": 3},
    "beschreibung": {"type": "string", "minLength": 10},
    "prioritaet": {"enum": ["P0", "P1", "P2", "P3"]},
    "status": {"enum": ["geplant", "bereit", "in_arbeit", "implementiert", "verifiziert", "blockiert"]},
    "todo_id": {"type": "string", "pattern": "^TODO-[A-Z0-9][A-Z0-9._-]*$"},
    "quelle": {"type": "string"},
    "risiko": {"enum": ["niedrig", "mittel", "hoch", "kritisch"]},
    "akzeptanzkriterien": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string", "pattern": "^AC-[A-Z0-9][A-Z0-9._-]*$"},
          "text": {"type": "string", "minLength": 5}
        }
      }
    },
    "test_ids": {"type": "array", "items": {"type": "string", "pattern": "^TEST-[A-Z0-9][A-Z0-9._-]*$"}, "uniqueItems": true},
    "evidenz_ids": {"type": "array", "items": {"type": "string", "pattern": "^EVD-[A-Z0-9][A-Z0-9._-]*$"}, "uniqueItems": true}
  }
}
