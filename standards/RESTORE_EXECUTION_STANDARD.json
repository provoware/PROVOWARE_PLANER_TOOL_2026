{
  "schema_version": 1,
  "standard_id": "PROVOWARE-RESTORE-EXECUTION",
  "version": "1.0.0",
  "status": "VERBINDLICH",
  "rules": {
    "persistent_intent_before_destructive_commit_required": true,
    "exclusive_restore_lease_required": true,
    "planner_write_guard_required": true,
