    "ambiguous_recovery_must_fail_closed": true,
    "single_physical_restore_core_required": true,
    "parallel_file_replace_path_forbidden": true,
    "hard_process_exit_after_replace_test_required": true,
    "runtime_restore_state_never_transport_required": true
  }
}
